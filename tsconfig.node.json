{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "vitest.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/test/platform.ts",
    "src/test/cu-mcp-kit.ts",
    "src/test/update-scripts-win.test.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noImplicitAny": true,
    "types": ["electron-vite/node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  }
}

                },
                "Categories": {
                  "value": "Files from Arquipelagos.pt|Items with VRTS permission confirmed|2017 in Funchal|Mercado de Frutas by August Plum (oil on canvas, 1853)|Uploaded with Catrapilha|Furniture in Museu Quinta das Cruzes|Photographs by José Lemos Silva|Salão Nobre (Museu Quinta das Cruzes)",
                  "source": "commons-categories",
                  "hidden": ""

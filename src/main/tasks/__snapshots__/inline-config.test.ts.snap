exports[`buildInlineConfig: permisos del agente de tareas > sandbox + MCP usuario + reglas: snapshot completo del config 1`] = `
{
  "agent": {
    "computer": {
      "disable": true,
      "permission": {
        "bash": {
          "npm test": "allow",
        },
        "external_directory": {
          "/fixture/x/*": "allow",
        },
        "github_*": "ask",
      },
    },
    "lazunox-worker": {
      "description": "Ejecuta un plan creando y editando archivos dentro de la carpeta de la tarea",
      "mode": "subagent",
      "model": "inherit",
      "permission": {
        "*": "allow",
        "bash": {
          ""$LAZUNOX_PYTHON"": "allow",
          ""$LAZUNOX_PYTHON" *": "allow",
          ""\${LAZUNOX_PYTHON}"": "allow",
          ""\${LAZUNOX_PYTHON}" *": "allow",
          "$*": "ask",
          "$LAZUNOX_PYTHON": "allow",
          "$LAZUNOX_PYTHON *": "allow",
          "\${LAZUNOX_PYTHON}": "allow",
          "\${LAZUNOX_PYTHON} *": "allow",
          "*": "allow",
          "Invoke-Expression": "ask",
          "Invoke-Expression *": "ask",
          "bash": "ask",
          "bash *": "ask",
          "cmd": "ask",
          "cmd *": "ask",
          "dash": "ask",
          "dash *": "ask",
          "eval": "ask",
          "eval *": "ask",
          "find * -delete*": "ask",
          "fish": "ask",
          "fish *": "ask",
          "git push*": "deny",
          "iex": "ask",
          "iex *": "ask",
          "ksh": "ask",
          "ksh *": "ask",
          "npm test": "allow",
          "powershell": "ask",
          "powershell *": "ask",
          "pwsh": "ask",
          "pwsh *": "ask",
          "rm *": "ask",
          "rmdir *": "ask",
          "sh": "ask",
          "sh *": "ask",
          "shutdown*": "deny",
          "source": "ask",
          "source *": "ask",
          "sudo *": "deny",
          "trash *": "ask",
          "unlink *": "ask",
          "xargs": "ask",
          "xargs *": "ask",
          "zsh": "ask",
          "zsh *": "ask",
        },
        "doom_loop": "ask",
        "edit": "allow",
        "external_directory": {
          "*": "ask",
          "/fixture/x/*": "allow",
        },
        "github_*": "ask",
        "glob": "allow",
        "grep": "allow",
        "list": "allow",
        "question": "allow",
        "read": {
          "*": "allow",
          "mcp:*": "ask",
        },
        "task": {
          "*": "deny",
        },
        "todowrite": "allow",
        "webfetch": "allow",
        "websearch": "allow",
      },
      "prompt": "Eres el ayudante ejecutor de Overdrive. Ejecuta el encargo directamente en los archivos de la carpeta de trabajo, verifica el resultado y resume los cambios. Respeta las instrucciones de la tarea, sus permisos y su aislamiento. No devuelvas el código como sustituto de escribir los archivos. No controles otras aplicaciones ni lances otros ayudantes.",
    },
    "tasks": {
      "permission": {
        "bash": {
          "npm test": "allow",
        },
        "external_directory": {
          "/fixture/x/*": "allow",
        },
        "github_*": "ask",
        "task": {
          "*": "deny",
          "lazunox-helper": "allow",
          "lazunox-worker": "allow",
        },
      },
    },
  },
  "autoupdate": false,
  "mcp": {
    "github": {
      "type": "local",
    },
  },
  "share": "disabled",
}
`;


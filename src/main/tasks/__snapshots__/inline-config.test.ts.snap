// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildInlineConfig: permisos del agente de tareas > control total + computer + navegador: snapshot completo del config 1`] = `
{
  "agent": {
    "lazunox-worker": {
      "description": "Ejecuta un plan creando y editando archivos dentro de la carpeta de la tarea",
      "mode": "subagent",
      "model": "inherit",
      "permission": {
        "browser_*": "deny",
        "computer_*": "deny",
        "task": {
          "*": "deny",
        },
      },
      "prompt": "Eres el ayudante ejecutor de Overdrive. Ejecuta el encargo directamente en los archivos de la carpeta de trabajo, verifica el resultado y resume los cambios. Respeta las instrucciones de la tarea, sus permisos y su aislamiento. No devuelvas el código como sustituto de escribir los archivos. No controles otras aplicaciones ni lances otros ayudantes.",
    },
    "tasks": {
      "permission": {
        "browser_*": "deny",
        "computer_*": "deny",
      },
    },
  },
  "autoupdate": false,
  "mcp": {
    "browser": {
      "type": "remote",
      "url": "http://127.0.0.1:1234/mcp",
    },
    "computer": {
      "type": "remote",
      "url": "http://127.0.0.1:5678/mcp",
    },
  },
  "share": "disabled",
}
`;


// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildSandboxProfile (caracterización Seatbelt) > "Permitir borrar" concedido: sin deny de unlink en la principal, scratch sin regla extra 1`] = `
"(version 1)
(allow default)

;; Escritura: solo la carpeta de la tarea + directorio privado del servidor + temporales.
(deny file-write*)
(allow file-write*
  (subpath "/fixture/work/proyecto")
  (subpath "/fixture/userData/tasks-sandbox/0123456789abcdef")
  (subpath "/private/tmp")
  (subpath "/private/var/folders")
  (subpath "/private/var/folders/zz/fixed/T")
  (literal "/dev/null") (literal "/dev/zero") (literal "/dev/tty")
  (literal "/dev/dtracehelper") (literal "/dev/random") (literal "/dev/urandom")
  (regex #"^/dev/ttys[0-9]+$") (regex #"^/dev/fd/"))

;; Secretos del usuario: sin lectura ni escritura.
(deny file-read* file-write*
  (subpath "/Users/fixture/.ssh")
  (subpath "/Users/fixture/.aws")
  (subpath "/Users/fixture/.gnupg")
  (subpath "/Users/fixture/.kube")
  (subpath "/Users/fixture/.docker")
  (subpath "/Users/fixture/.azure")
  (subpath "/Users/fixture/.oci")
  (subpath "/Users/fixture/.ibmcloud")
  (subpath "/Users/fixture/.terraform.d")
  (subpath "/Users/fixture/.vault-token")
  (subpath "/Users/fixture/.boto")
  (subpath "/Users/fixture/.s3cfg")
  (subpath "/Users/fixture/.databrickscfg")
  (subpath "/Users/fixture/.colima")
  (subpath "/Users/fixture/.lima")
  (subpath "/Users/fixture/.config")
  (subpath "/Users/fixture/.local/share/opencode")
  (subpath "/Users/fixture/.local/state/opencode")
  (subpath "/Users/fixture/.cache")
  (subpath "/Users/fixture/.npm")
  (subpath "/Users/fixture/.claude")
  (subpath "/Users/fixture/.claude.json")
  (subpath "/Users/fixture/.claude.json.backup")
  (subpath "/Users/fixture/.codex")
  (subpath "/Users/fixture/.cursor")
  (subpath "/Users/fixture/.windsurf")
  (subpath "/Users/fixture/.codeium")
  (subpath "/Users/fixture/.gemini")
  (subpath "/Users/fixture/.continue")
  (subpath "/Users/fixture/.aider.conf.yml")
  (subpath "/Users/fixture/.aider.chat.history.md")
  (subpath "/Users/fixture/.vscode")
  (subpath "/Users/fixture/.zed")
  (subpath "/Users/fixture/.ms-365-mcp-server")
  (subpath "/Users/fixture/.mcp-auth")
  (subpath "/Users/fixture/.mcp.json")
  (subpath "/Users/fixture/.netrc")
  (subpath "/Users/fixture/.git-credentials")
  (subpath "/Users/fixture/.gitconfig")
  (subpath "/Users/fixture/.npmrc")
  (subpath "/Users/fixture/.yarnrc")
  (subpath "/Users/fixture/.yarnrc.yml")
  (subpath "/Users/fixture/.pypirc")
  (subpath "/Users/fixture/.pgpass")
  (subpath "/Users/fixture/.my.cnf")
  (subpath "/Users/fixture/.mylogin.cnf")
  (subpath "/Users/fixture/.terraformrc")
  (subpath "/Users/fixture/.cargo/credentials")
  (subpath "/Users/fixture/.cargo/credentials.toml")
  (subpath "/Users/fixture/.gem/credentials")
  (subpath "/Users/fixture/.m2/settings.xml")
  (subpath "/Users/fixture/.gradle/gradle.properties")
  (subpath "/Users/fixture/.composer/auth.json")
  (subpath "/Users/fixture/.bundle/config")
  (subpath "/Users/fixture/.cloudflared")
  (subpath "/Users/fixture/.wrangler")
  (subpath "/Users/fixture/.vercel")
  (subpath "/Users/fixture/.netlify")
  (subpath "/Users/fixture/.fly")
  (subpath "/Users/fixture/.railway")
  (subpath "/Users/fixture/.stripe")
  (subpath "/Users/fixture/.supabase")
  (subpath "/Users/fixture/.expo")
  (subpath "/Users/fixture/.eas")
  (subpath "/Users/fixture/.firebase")
  (subpath "/Users/fixture/.zshrc")
  (subpath "/Users/fixture/.zshenv")
  (subpath "/Users/fixture/.zprofile")
  (subpath "/Users/fixture/.zlogin")
  (subpath "/Users/fixture/.zlogout")
  (subpath "/Users/fixture/.bashrc")
  (subpath "/Users/fixture/.bash_profile")
  (subpath "/Users/fixture/.bash_login")
  (subpath "/Users/fixture/.bash_logout")
  (subpath "/Users/fixture/.profile")
  (subpath "/Users/fixture/.envrc")
  (subpath "/Users/fixture/.env")
  (subpath "/Users/fixture/.zsh_history")
  (subpath "/Users/fixture/.bash_history")
  (subpath "/Users/fixture/.zsh_sessions")
  (subpath "/Users/fixture/.zhistory")
  (subpath "/Users/fixture/.sh_history")
  (subpath "/Users/fixture/.python_history")
  (subpath "/Users/fixture/.node_repl_history")
  (subpath "/Users/fixture/.irb_history")
  (subpath "/Users/fixture/.mysql_history")
  (subpath "/Users/fixture/.psql_history")
  (subpath "/Users/fixture/.sqlite_history")
  (subpath "/Users/fixture/.rediscli_history")
  (subpath "/Users/fixture/.lesshst")
  (subpath "/Users/fixture/.viminfo")
  (subpath "/Users/fixture/Library/Application Support/Google")
  (subpath "/Users/fixture/Library/Application Support/Chromium")
  (subpath "/Users/fixture/Library/Application Support/Firefox")
  (subpath "/Users/fixture/Library/Application Support/BraveSoftware")
  (subpath "/Users/fixture/Library/Application Support/Microsoft Edge")
  (subpath "/Users/fixture/Library/Application Support/Arc")
  (subpath "/Users/fixture/Library/Application Support/com.operasoftware.Opera")
  (subpath "/Users/fixture/Library/Application Support/Vivaldi")
  (subpath "/Users/fixture/Library/Safari")
  (subpath "/Users/fixture/Library/Cookies")
  (subpath "/Users/fixture/Library/HTTPStorages")
  (subpath "/Users/fixture/Library/WebKit")
  (subpath "/Users/fixture/Library/Keychains")
  (subpath "/Users/fixture/Library/Mail")
  (subpath "/Users/fixture/Library/Messages")
  (subpath "/Users/fixture/Library/Accounts")
  (subpath "/Users/fixture/Library/IdentityServices")
  (subpath "/Users/fixture/Library/Containers/com.apple.Safari")
  (subpath "/Users/fixture/Library/Group Containers")
  (subpath "/Users/fixture/Library/Application Support/Claude")
  (subpath "/Users/fixture/Library/Application Support/Code")
  (subpath "/Users/fixture/Library/Application Support/Cursor")
  (subpath "/Users/fixture/Library/Application Support/Windsurf")
  (subpath "/Users/fixture/Library/Application Support/Zed")
  (subpath "/Users/fixture/Library/Application Support/Slack")
  (subpath "/Users/fixture/Library/Application Support/discord")
  (subpath "/Users/fixture/Library/Application Support/Microsoft")
  (subpath "/Users/fixture/Library/Application Support/Notion")
  (subpath "/Users/fixture/Library/Application Support/1Password")
  (subpath "/Users/fixture/Library/Application Support/Bitwarden")
  (subpath "/Users/fixture/Library/Application Support/Dropbox")
  (subpath "/Users/fixture/Library/Application Support/zoom.us")
  (subpath "/Users/fixture/Library/Application Support/Signal")
  (subpath "/Users/fixture/Library/Application Support/Telegram Desktop")
  (subpath "/Users/fixture/Library/Application Support/WhatsApp")
  (subpath "/Users/fixture/Library/Application Support/Postman")
  (subpath "/Users/fixture/Library/Application Support/MobileSync")
  (subpath "/Users/fixture/Library/Application Support/AddressBook")
  (subpath "/Users/fixture/Library/Application Support/CallHistoryDB")
  (subpath "/Users/fixture/Library/Application Support/com.apple.TCC")
)

;; userData de la app (tokens MCP, tasks-folders.json, otros sandboxes): denegado…
(deny file-read* file-write* (subpath "/fixture/userData"))
;; (stat sí: realpath/lstat de las rutas intermedias; no expone contenido)
(allow file-read-metadata (subpath "/fixture/userData"))
;; …salvo la config de OpenCode de la app (agentes), solo lectura…
(allow file-read* (subpath "/fixture/userData/opencode-config"))
;; …y el directorio privado de este servidor.
(allow file-read* file-write* (subpath "/fixture/userData/tasks-sandbox/0123456789abcdef"))

;; Sin procesos fuera del sandbox: LaunchServices (open), Apple Events (osascript),
;; launchd (launchctl), Automator/Atajos, capturas y portapapeles.
(deny process-exec
  (literal "/usr/bin/open")
  (literal "/usr/bin/osascript")
  (literal "/usr/bin/osacompile")
  (literal "/bin/launchctl")
  (literal "/usr/bin/automator")
  (literal "/usr/bin/shortcuts")
  (literal "/usr/bin/lsappinfo")
  (literal "/usr/sbin/screencapture")
  (literal "/usr/bin/pbcopy")
  (literal "/usr/bin/pbpaste")
)
(deny appleevent-send)
;; Información de OTROS procesos (libproc: ruta, tareas, recursos, descriptores): denegada; solo el
;; propio. Forma "deny todo + allow (target self)" (la de los perfiles del sistema; \`(target others)\`
;; no se aplica). OJO: KERN_PROCARGS2 (\`ps eww\`) no pasa por ninguna operación Seatbelt: ver SEGURIDAD.md.
(deny process-info*)
(allow process-info* (target self))
(deny mach-lookup
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name "com.apple.lsd.open")
  (global-name "com.apple.lsd.modifydb")
  (global-name "com.apple.coreservices.appleevents")
  (global-name "com.apple.pasteboard.1")
  (global-name "com.apple.screencapture.interactive")
)

;; Red: denegada salvo el/los proxy(es) locales de Tareas y el puerto del servidor.
(deny network*)
(allow network-bind (local ip "localhost:*"))
"
`;


(allow file-read* (subpath "/fixture/userData/opencode-config"))
;; …y el directorio privado de este servidor.
(allow file-read* file-write* (subpath "/fixture/userData/tasks-sandbox/0123456789abcdef"))

;; Sin procesos fuera del sandbox: LaunchServices (open), Apple Events (osascript),
;; launchd (launchctl), Automator/Atajos, capturas y portapapeles.
(deny process-exec
  (literal "/usr/bin/open")
  (literal "/usr/bin/osascript")
  (literal "/usr/bin/osacompile")
  (literal "/bin/launchctl")
  (literal "/usr/bin/automator")
  (literal "/usr/bin/shortcuts")
  (literal "/usr/bin/lsappinfo")
  (literal "/usr/sbin/screencapture")
  (literal "/usr/bin/pbcopy")
  (literal "/usr/bin/pbpaste")
)
(deny appleevent-send)
;; Información de OTROS procesos (libproc: ruta, tareas, recursos, descriptores): denegada; solo el
;; propio. Forma "deny todo + allow (target self)" (la de los perfiles del sistema; \`(target others)\`
;; no se aplica). OJO: KERN_PROCARGS2 (\`ps eww\`) no pasa por ninguna operación Seatbelt: ver SEGURIDAD.md.
(deny process-info*)
(allow process-info* (target self))
(deny mach-lookup
  (global-name "com.apple.coreservices.launchservicesd")
  (global-name "com.apple.lsd.open")
  (global-name "com.apple.lsd.modifydb")
  (global-name "com.apple.coreservices.appleevents")
  (global-name "com.apple.pasteboard.1")
  (global-name "com.apple.screencapture.interactive")
)

;; Red: denegada salvo el/los proxy(es) locales de Tareas y el puerto del servidor.
(deny network*)
(allow network-bind (local ip "localhost:*"))

;; Borrado/renombrado NO concedido: unlink/rmdir/rename denegados (principal sin permiso y carpetas adicionales rw).
(deny file-write-unlink (subpath "/fixture/work"))

;; Borrado concedido en la principal aunque una carpeta rw adicional la contenga.
(allow file-write-unlink (subpath "/fixture/work/proyecto"))

;; Scratch (.lazunox/trabajo): borrar y renombrar permitido.
(allow file-write-unlink (subpath "/fixture/work/proyecto/.lazunox/trabajo"))
"
`;


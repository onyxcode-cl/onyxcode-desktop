// Servicio de conexión de Lazunox (remoto fuera de casa). NO se despliega desde el repositorio ni desde CI: lo publica el dueño
// desde su Mac siguiendo README.md. Aquí no hay secretos: los de TURN se cargan con `wrangler secret put`.
{
  "name": "lazunox-remoto",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../../pwa/dist-site",
    "binding": "ASSETS",
    "run_worker_first": ["/v1/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // El plan gratuito solo admite Durable Objects con SQLite. La clase no escribe nada (ni usa su almacenamiento).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }],
  // Límite por IP (30 conexiones por minuto). Si `wrangler` rechaza este bloque en tu plan, bórralo: la regla del panel (README, paso 7) hace lo mismo.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  // Sin registros: el servicio no deja rastro de las conexiones.
  "observability": { "enabled": false },
  "vars": {
    // EXTERNO-PENDIENTE: D3 (debe coincidir con CLOUD_DOMAIN de brand.ts; se cambia al registrar lazunox.cl).
    "ALLOWED_ORIGINS": "https://remoto.onyxcode.cl",
    // Interruptor de TURN: APAGADO por defecto. Solo funciona si además se cargan los dos secretos (README, paso opcional).
    "TURN_ENABLED": "false"
  }
}

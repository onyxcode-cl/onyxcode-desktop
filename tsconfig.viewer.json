{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": ["src/viewer/**/*", "vite.viewer.config.ts", "src/shared/**/*"],
  "exclude": ["src/viewer/**/*.test.ts"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["src/shared/*"]
    }
  }
}

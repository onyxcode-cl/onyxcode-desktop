    },
    "ax-action": {
      "args": [
        {
          "name": "bundleId",
          "type": "appKey",
          "required": true,
          "note": "macOS: bundle id; Windows: appKey (exe:<ruta>|pub:<editor> o aumid:<id>)"
        },
        {
          "name": "ref",
          "type": "string",
          "required": true
        },
        {
          "name": "action",
          "type": "enum",
          "required": true,

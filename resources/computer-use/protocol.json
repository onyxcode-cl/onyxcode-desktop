        },
        {
          "name": "jsonQuery",
          "type": "json",
          "required": true
        }
      ],
      "output": {
        "matches": "object[]"
      },
      "exits": [
        2,
        7
      ],
      "win32": "same"
    },
    "ax-frame": {
      "args": [
        {
          "name": "bundleId",

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "catalogo.schema.json",
  "title": "Catálogo de Personalización de Lazunox",
  "description": "Esquema de resources/catalogo/catalogo.json. El validador que decide es src/shared/catalogo.ts (validateCatalog) y lo exige src/test/catalogo.test.ts; este archivo es la misma regla en formato JSON Schema para editores y para quien proponga una ficha (docs/CATALOGO.md).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "updatedAt", "groups", "skills", "connectors"],
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 2, "description": "2 = conectores remotos y locales (F8-B186)." },
    "catalogVersion": { "type": "integer", "minimum": 1, "description": "Sube cada vez que cambia el contenido." },
    "updatedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "skills": { "type": "array", "items": { "$ref": "#/$defs/skill" } },
    "connectors": { "type": "array", "items": { "$ref": "#/$defs/connector" } }
  },
  "$defs": {
    "icon": {
      "enum": [
        "book-open", "bug", "briefcase", "calendar", "cloud", "compass", "file-text", "file-type", "folder", "git-branch",
        "list-checks", "mail", "notebook", "plug", "presentation", "sparkles", "table", "terminal", "users", "wallet"
      ]
    },
    "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64 },
    "httpsUrl": { "type": "string", "pattern": "^https://[^/?#@\\s]+(/[^?#\\s]*)?$" },
    "lines": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 220 }, "minItems": 1, "maxItems": 6 },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "icon"],
      "properties": { "id": { "$ref": "#/$defs/id" }, "icon": { "$ref": "#/$defs/icon" } }
    },
    "skill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "icon", "description", "permissions", "examples", "verifiedAt", "verification", "reviewed"],
      "properties": {
        "id": { "$ref": "#/$defs/id", "description": "Nombre de la carpeta en resources/opencode/skills; ahí tiene que existir su SKILL.md." },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 60 },
        "icon": { "$ref": "#/$defs/icon" },
        "description": { "type": "string", "minLength": 10, "maxLength": 200 },
        "permissions": { "$ref": "#/$defs/lines", "description": "Lo que le permite hacer al agente, en lenguaje llano." },
        "examples": { "type": "array", "items": { "type": "string", "maxLength": 140 }, "minItems": 1, "maxItems": 4 },
        "verifiedAt": { "$ref": "#/$defs/date" },
        "verification": { "type": "string", "minLength": 20, "maxLength": 500, "description": "Cómo se comprobó que hace lo que dice." },
        "reviewed": { "const": true, "description": "Solo se empaquetan fichas revisadas por el dueño." }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "kind", "pattern", "maxLength", "target"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": { "enum": ["secret", "text"] },
        "pattern": { "type": "string", "pattern": "^\\^.*\\$$", "description": "Expresión anclada (^…$)." },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 4096 },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["header", "template"],
          "properties": { "header": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" }, "template": { "type": "string", "description": "Lleva exactamente un {value}." } }
        },
        "help": { "type": "string" }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manager", "package", "version", "dir", "files", "entry", "args", "env", "author", "license", "sourceUrl", "downloadFrom", "approxMB", "tokenDir", "platforms", "tools"],
      "description": "Cómo se instala y se lanza un conector local. Todo es fijo: nada de lo que escriba la persona entra en un comando, un argumento ni una variable de entorno. El validador que decide es validateCatalog.",
      "properties": {
        "manager": { "enum": ["uv", "npm"] },
        "package": { "type": "string", "pattern": "^(@[a-z0-9][a-z0-9-]*/)?[a-z0-9][a-z0-9._-]*$", "maxLength": 100 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Versión EXACTA, sin rangos." },
        "python": { "type": "string", "pattern": "^3\\.\\d{1,2}$", "description": "Solo con uv." },
        "dir": { "$ref": "#/$defs/id", "description": "Carpeta de resources/catalogo/conectores-locales/ con los archivos de bloqueo." },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "sha256"],
            "properties": { "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" }, "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
          },
          "description": "Archivos de bloqueo (uv: requirements.lock; npm: package.json y package-lock.json). Cada paquete lleva además su propio hash dentro de ellos."
        },
        "entry": { "type": "string", "pattern": "^[A-Za-z0-9._@-]+(/[A-Za-z0-9._@-]+)*$", "description": "Ruta relativa dentro de la carpeta del conector, sin «..»." },
        "args": { "type": "array", "minItems": 1, "maxItems": 24, "contains": { "const": "--read-only" }, "items": { "type": "string", "pattern": "^-{0,2}[A-Za-z0-9][A-Za-z0-9._,:=@+/-]*$", "maxLength": 80 }, "description": "Argumentos fijos; --read-only es obligatorio." },
        "env": { "type": "object", "propertyNames": { "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }, "additionalProperties": { "type": "string", "maxLength": 300 }, "description": "Variables fijas; {dir} = carpeta del conector. Sin secretos." },
        "clientFile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["env", "file", "helpUrl"],
          "properties": {
            "env": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" },
            "file": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
            "helpUrl": { "$ref": "#/$defs/httpsUrl" }
          },
          "description": "Archivo del cliente OAuth propio de la persona: main lo copia sin pasarlo por la pantalla."
        },
        "author": { "type": "string", "minLength": 1, "maxLength": 80 },
        "license": { "type": "string", "minLength": 1, "maxLength": 40 },
        "sourceUrl": { "$ref": "#/$defs/httpsUrl" },
        "downloadFrom": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "pattern": "^[a-z0-9]([a-z0-9-]*[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]*[a-z0-9])?)+$" } },
        "approxMB": { "type": "integer", "minimum": 1, "maximum": 2000 },
        "tokenDir": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
        "platforms": { "type": "array", "minItems": 1, "items": { "enum": ["darwin", "win32", "linux"] } },
        "tools": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed", "blocked", "auth"],
          "properties": {
            "allowed": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" } },
            "blocked": { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" } },
            "auth": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$" } }
          }
        }
      }
    },
    "connector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "name", "title", "publisher", "group", "icon", "description", "transport", "auth", "inputs", "capabilities", "cannot",
        "examples", "writes", "dataLeaves", "docsUrl", "verifiedAt", "verification", "reviewed"
      ],
      "allOf": [
        { "if": { "properties": { "transport": { "const": "remote" } } }, "then": { "required": ["url"], "not": { "required": ["runtime"] } } },
        {
          "if": { "properties": { "transport": { "const": "local" } } },
          "then": { "required": ["runtime"], "not": { "required": ["url"] }, "properties": { "auth": { "const": "account" }, "writes": { "const": false }, "inputs": { "maxItems": 0 } } }
        }
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$" },
        "title": { "type": "string", "minLength": 1, "maxLength": 80 },
        "publisher": { "type": "string", "minLength": 1, "maxLength": 60 },
        "group": { "type": "string", "description": "Id de un grupo declarado en «groups»." },
        "icon": { "$ref": "#/$defs/icon" },
        "description": { "type": "string", "minLength": 10, "maxLength": 200 },
        "transport": { "enum": ["remote", "local"], "description": "remote = una URL https (añadirlo no ejecuta nada). local = un programa de un tercero que la app instala y ejecuta en el equipo (F8-B186): exige «runtime»." },
        "url": { "$ref": "#/$defs/httpsUrl" },
        "runtime": { "$ref": "#/$defs/runtime" },
        "auth": { "enum": ["none", "token", "oauth", "account"], "description": "account = el propio programa local pide entrar a la cuenta; solo conectores locales." },
        "inputs": { "type": "array", "items": { "$ref": "#/$defs/input" }, "description": "Exactamente uno o más si auth es «token»; vacío en los demás casos." },
        "capabilities": { "$ref": "#/$defs/lines" },
        "cannot": { "$ref": "#/$defs/lines", "description": "Lo que NO podrá hacer." },
        "examples": { "type": "array", "items": { "type": "string", "maxLength": 140 }, "minItems": 1, "maxItems": 4 },
        "writes": { "type": "boolean" },
        "dataLeaves": { "type": "string", "minLength": 10, "maxLength": 400, "description": "Qué datos salen de este equipo hacia el servicio." },
        "docsUrl": { "$ref": "#/$defs/httpsUrl" },
        "accountTested": { "type": "boolean", "description": "false = nadie lo ha probado con una cuenta real; la pantalla lo dice. Ausente = no se afirma nada." },
        "verifiedAt": { "$ref": "#/$defs/date" },
        "verification": { "type": "string", "minLength": 20, "maxLength": 500 },
        "reviewed": { "const": true }
      }
    }
  }
}

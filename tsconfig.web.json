{
  "extends": "@electron-toolkit/tsconfig/tsconfig.web.json",
  "include": [
    "src/renderer/src/env.d.ts",
    "src/renderer/src/**/*",
    "src/renderer/src/**/*.tsx",
    "src/renderer/quick/**/*",
    "src/renderer/overlay/**/*",
    "src/renderer/browser/**/*",
    "src/preload/*.d.ts",
    "src/shared/**/*",
    "src/main/migrations/legacy-names.ts",
    "src/test/**/*"
  ],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "noImplicitAny": true,
    "baseUrl": ".",
    "paths": {
      "@renderer/*": ["src/renderer/src/*"],
      "@shared/*": ["src/shared/*"]
    }
  }
}

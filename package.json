{
  "name": "onyxcode",
  "productName": "OnyxCode",
  "version": "0.3.0",
  "description": "Cliente de escritorio para OpenCode (Chat, Code, Tareas, Rutinas)",
  "main": "./out/main/index.js",
  "author": "bentec",
  "private": true,
  "scripts": {
    "dev": "sh resources/computer-use/build.sh --if-missing && sh resources/launcher/build.sh --if-missing && electron-vite dev",
    "build": "sh resources/computer-use/build.sh --if-missing && sh resources/launcher/build.sh --if-missing && electron-vite build",
    "preview": "electron-vite preview",
    "build:helper": "sh resources/computer-use/build.sh",
    "build:launcher": "sh resources/launcher/build.sh",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "package": "node scripts/fetch-opencode.mjs --if-missing && npm run build && electron-builder --mac --arm64",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "format:check": "prettier --check src",
    "test:transform": "node e2e/transform.mjs",
    "test:smoke": "node e2e/smoke.mjs",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:e2e:prod": "E2E_MODE=prod vitest run -c vitest.e2e.config.ts",
    "verify:release": "node scripts/verify-release.mjs",
    "check:opencode": "node scripts/check-opencode.mjs",
    "verify": "npm run typecheck && npm test && npm run lint && npm run format:check && npm run build && npm run test:transform && npm run test:smoke && npm run test:e2e"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "croner": "^10.0.1",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/notarize": "^2.5.0",
    "@opencode-ai/sdk": "1.18.32",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "highlight.js": "~11.11.2",
    "lucide-react": "^1.48.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "node-pty": "1.2.0-beta.14"
  }
}

{
  "name": "lazunox",
  "productName": "Lazunox",
  "version": "1.1.0",
  "description": "Cliente de escritorio para OpenCode (Chat, Code, Tareas, Rutinas)",
  "main": "./out/main/index.js",
  "author": "bentec",
  "private": true,
  "scripts": {
    "dev": "node scripts/build-native.mjs && electron-vite dev",
    "build": "node scripts/build-native.mjs && npm run build:pwa && npm run build:viewer && electron-vite build",
    "build:pwa": "node scripts/build-pwa.mjs",
    "build:viewer": "vite build --config vite.viewer.config.ts && node scripts/copy-pdfjs-assets.mjs && node scripts/copy-docx-fonts.mjs",
    "build:site": "node scripts/build-site.mjs",
    "preview": "electron-vite preview",
    "build:helper": "sh resources/computer-use/build.sh",
    "build:launcher": "sh resources/launcher/build.sh",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck:pwa": "tsc --noEmit -p pwa/tsconfig.json",
    "typecheck:viewer": "tsc --noEmit -p tsconfig.viewer.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web && npm run typecheck:pwa && npm run typecheck:viewer",
    "fetch:python": "node scripts/fetch-python.mjs --if-missing",
    "package": "node scripts/check-node-modules.mjs && node scripts/fetch-opencode.mjs --if-missing && npm run fetch:python && npm run build && electron-builder --mac --arm64",
    "package:win": "node scripts/fetch-opencode.mjs --if-missing && npm run build && node scripts/check-win-bundle.mjs --config-only && node node_modules/electron-builder/cli.js --win nsis --x64",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:fs": "node scripts/with-env.mjs LAZUNOX_FS_IT=1 -- vitest run src/main/tasks/restore-points.fs.test.ts",
    "test:stress": "node scripts/with-env.mjs LAZUNOX_STRESS=1 -- vitest run src/main/tasks/restore-points.stress.test.ts",
    "lint": "eslint src pwa",
    "format:check": "prettier --check src pwa",
    "test:transform": "node e2e/transform.mjs",
    "test:smoke": "node e2e/smoke.mjs",
    "test:e2e": "vitest run -c vitest.e2e.config.ts",
    "test:e2e:prod": "node scripts/with-env.mjs E2E_MODE=prod -- vitest run -c vitest.e2e.config.ts",
    "perf:startup": "node scripts/with-env.mjs E2E_MODE=prod -- vitest run -c vitest.perf.config.ts",
    "size:pwa": "node scripts/pwa-size-report.mjs --check",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:signed": "node scripts/verify-signed.mjs",
    "test:release-scripts": "node --test scripts/*.test.mjs scripts/install/*.test.mjs",
    "verify:update-manifest": "node scripts/verify-update-manifest.mjs",
    "verify:bundled": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify-bundled.mjs",
    "check:win-bundle": "node scripts/check-win-bundle.mjs",
    "stage:wsl-bundle": "node scripts/stage-wsl-bundle.mjs",
    "check:opencode": "node scripts/check-opencode.mjs",
    "check:mcp-catalog": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/check-mcp-catalog.mjs",
    "verify": "npm run typecheck && npm test && npm run lint && npm run format:check && npm run build && npm run test:transform && npm run test:smoke && npm run test:e2e"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^4.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@noble/hashes": "2.4.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "croner": "^10.0.1",
    "diff": "^9.0.0",
    "docx-preview": "^0.4.1",
    "exceljs": "^4.4.0",
    "node-datachannel": "0.33.4",
    "pdfjs-dist": "^6.4.299",
    "pptxgenjs": "^4.0.1",
    "qrcode": "1.5.4",
    "sherpa-onnx-node": "^1.13.8",
    "ws": "8.22.0",
    "xlsx": "file:vendor/sheetjs/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@electron/notarize": "^2.5.0",
    "@fontsource/caladea": "^5.3.0",
    "@fontsource/carlito": "^5.3.0",
    "@opencode-ai/sdk": "1.19.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "8.18.2",
    "@typopro/web-liberation": "^3.7.5",
    "@vitejs/plugin-react": "^5.2.0",
    "axe-core": "^4.13.0",
    "electron": "44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "happy-dom": "^15.11.7",
    "highlight.js": "~11.11.2",
    "jsdom": "^25.0.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.48.0",
    "playwright-core": "1.63.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^7.3.6",
    "vitest": "^3.2.7",
    "zustand": "^5.0.15"
  },
  "optionalDependencies": {
    "node-pty": "1.2.0-beta.14"
  },
  "overrides": {
    "image-size": "^2.0.3",
    "uuid": "^11.1.1"
  }
}
